{
    "name": "verti-grade",
    "version": "1.10.3",
    "private": true,
    "scripts": {
        "build": "nuxt build",
        "dev": "CAP_SECRET=${CAP_SECRET:-dev-only-cap-secret-not-for-production} concurrently \"nuxt dev\" \"npm run start:db\"",
        "start:db": "cd pocketbase && ./pocketbase serve --http=0.0.0.0:8090",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "prepare": "husky",
        "format": "prettier --write \"**/*.{js,vue,html,css}\"",
        "release": "release-it",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "e2e:up": "./e2e/scripts/app-up.sh",
        "e2e:down": "./e2e/scripts/app-down.sh"
    },
    "devDependencies": {
        "@cap.js/wasm": "0.0.7",
        "@cj-tech-master/excelts": "10.2.0",
        "@mdi/font": "7.4.47",
        "@nuxt/image": "2.1.0",
        "@nuxtjs/i18n": "10.6.0",
        "@playwright/test": "^1.63.0",
        "@types/pdfkit": "0.17.6",
        "@types/qrcode": "1.5.6",
        "@vitejs/plugin-vue": "6.0.9",
        "@vue/test-utils": "2.5.1",
        "cap-widget": "^0.1.57",
        "capjs-core": "^0.1.2",
        "concurrently": "10.0.5",
        "echarts": "6.1.0",
        "h3": "1.15.11",
        "happy-dom": "20.14.5",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.1",
        "nuxt": "^4.5.2",
        "pako": "^2.1.0",
        "pdfkit": "0.20.2",
        "pocketbase": "^0.28.1",
        "prettier": "3.9.8",
        "qrcode": "1.5.4",
        "release-it": "21.1.0",
        "sass": "1.104.0",
        "typescript": "7.0.2",
        "vite": "8.3.0",
        "vitest": "5.0.1",
        "vue": "3.5.42",
        "vue-qrcode-reader": "^5.7.3",
        "vuetify": "4.2.1",
        "vuetify-nuxt-module": "v1.0.0-rc.6"
    },
    "browserslist": [
        "defaults and fully supports es6-module"
    ],
    "packageManager": "yarn@4.18.0",
    "lint-staged": {
        "*.{js,ts,vue,html,css}": "prettier --write"
    },
    "release-it": {
        "$schema": "https://unpkg.com/release-it/schema/release-it.json",
        "git": {
            "tagName": "v${version}",
            "commitMessage": "release v${version}",
            "requireCleanWorkingDir": true,
            "push": true
        }
    }
}
