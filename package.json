{
    "name": "verti-grade",
    "version": "1.10.2",
    "private": true,
    "scripts": {
        "build": "nuxt build",
        "dev": "concurrently \"nuxt dev\" \"npm run start:db\"",
        "start:db": "cd pocketbase && ./pocketbase serve --http=0.0.0.0:8090",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "format": "prettier --write \"**/*.{js,vue,html,css}\"",
        "release": "release-it",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@cj-tech-master/excelts": "10.2.0",
        "@mdi/font": "7.4.47",
        "@nuxt/image": "2.1.0",
        "@nuxtjs/i18n": "10.6.0",
        "@types/pdfkit": "0.17.6",
        "@types/qrcode": "1.5.6",
        "@vitejs/plugin-vue": "6.0.8",
        "@vue/test-utils": "2.4.11",
        "concurrently": "10.0.5",
        "echarts": "6.1.0",
        "h3": "1.15.11",
        "happy-dom": "20.11.6",
        "nuxt": "^4.5.2",
        "pdfkit": "0.19.1",
        "pocketbase": "^0.28.0",
        "prettier": "3.9.6",
        "qrcode": "1.5.4",
        "release-it": "21.0.2",
        "sass": "1.103.1",
        "typescript": "7.0.2",
        "vite": "8.2.1",
        "vitest": "4.1.10",
        "vue": "3.5.41",
        "vue-qrcode-reader": "^5.7.3",
        "vuetify": "4.1.11",
        "vuetify-nuxt-module": "v1.0.0-rc.5"
    },
    "browserslist": [
        "defaults and fully supports es6-module"
    ],
    "packageManager": "yarn@4.17.1",
    "release-it": {
        "$schema": "https://unpkg.com/release-it/schema/release-it.json",
        "git": {
            "tagName": "v${version}",
            "commitMessage": "release v${version}",
            "requireCleanWorkingDir": true,
            "push": true
        }
    }
}
